  },
]
  \node[fact, font=\small\ttfamily, inner xsep=8pt] (bars)
    at (1,3) {candlesticks};

  \node[ent] (inst) at (0,2) {instruments};
  \node[cat] (durs) at (1,2) {candlestick\_durations};
