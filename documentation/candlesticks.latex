% Breakable typewriter identifiers (safe in titles).  Hyphens, slashes,
% dots, underscores, and colons are legal break points.
\ExplSyntaxOn
\NewDocumentCommand{\lispId}{m}
  {
    \texorpdfstring
      { \texttt { \lisp_id_break:n {#1} } }
      {#1}
  }
\cs_new_protected:Npn \lisp_id_break:n #1
  {
    \tl_set:Nn \l_tmpa_tl {#1}
    \tl_replace_all:Nnn \l_tmpa_tl { / } { /\allowbreak }
    \tl_replace_all:Nnn \l_tmpa_tl { - } { -\allowbreak }
    \tl_replace_all:Nnn \l_tmpa_tl { . } { .\allowbreak }
    \tl_replace_all:Nnn \l_tmpa_tl { _ } { \_\allowbreak }
    \tl_replace_all:Nnn \l_tmpa_tl { : } { :\allowbreak }
    \tl_replace_all:Nnn \l_tmpa_tl { > } { >\allowbreak }
    \tl_use:N \l_tmpa_tl
  }
\ExplSyntaxOff

\newcommand{\lispPackageChapter}[1]{\chapter{The \lispId{#1} Package}}
\newcommand{\lispFunctionSubsection}[1]{\subsection{The \lispId{#1} Function}}
\newcommand{\lispMacroSubsection}[1]{\subsection{The \lispId{#1} Macro}}
\newcommand{\lispGenericSubsection}[1]{\subsection{The \lispId{#1} Generic}}
\newcommand{\lispMethodsSubsection}[1]{\subsection{The \lispId{#1} Methods}}
\newcommand{\lispTypeSubsection}[1]{\subsection{The \lispId{#1} Type}}
\newcommand{\lispParameterSubsection}[1]{\subsection{The \lispId{#1} Parameter}}
\newcommand{\lispVariableSubsection}[1]{\subsection{The \lispId{#1} Variable}}

\newcommand{\lispArgs}[1]{\subsubsection*{Arguments and Values}}
\newcommand{\lispReturns}[1]{\subsubsection*{Returns}}
\newcommand{\lispSyntax}[1]{\subsubsection*{Syntax}}
\newcommand{\lispExamples}[1]{\subsubsection*{Examples}}
\newcommand{\lispAffectedBy}[1]{\subsubsection*{Affected By}}
\newcommand{\knownIssues}[1]{\subsubsection*{Known Issues}}

% Function signatures may be longer than the line; wrap at spaces.
\newcommand{\lispCall}[1]{%
  \par\addvspace{0.4ex}%
  {\raggedright\sloppy\small\noindent #1\par}%
  \addvspace{0.3ex}}

\definecolor{commentcolor}{rgb}{0.1,0.1,0.4}
\definecolor{identifiercolor}{rgb}{0.2,0.2,0.2}
\definecolor{keywordcolor}{rgb}{0.1,0.3,0.1}
\definecolor{cexcolor}{rgb}{0.25,0.25,0.4}
\lstset{
  basicstyle=\ttfamily\small,
  language=Lisp,
  morekeywords={make-instance},
  escapeinside={\%*}{*)},
  commentstyle=\itshape\color{commentcolor},
  identifierstyle=\color{identifiercolor},
  keywordstyle=\color{keywordcolor},
  breaklines=true,
  breakatwhitespace=true,
  columns=fullflexible,
  keepspaces=true
}
\setlength{\emergencystretch}{3em}
\newcommand{\cex}[1]{\textcolor{cexcolor}{\textit{#1}}}

\newcommand{\lispCode}[1]{\texttt{#1}}
\newcommand{\lispCodeArrow}{$\Longrightarrow$}
\newcommand{\lispExample}[2]{
  \noindent
  \texttt{#1} $\Longrightarrow$ \texttt{#2}
}
\newcommand{\lispVar}[1]{\texttt{\textit{#1}}}

\newcommand{\GithubIssue}[1]{\href{https://github.com/cgore/candlesticks/issues/#1}{{\color{red}[Issue \##1]}}}

